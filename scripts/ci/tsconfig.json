{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    "typeRoots": [
      "../../packages/db/node_modules/@types",
      "../../node_modules/@types"
    ]
  },
  "include": ["./*.ts"]
}
