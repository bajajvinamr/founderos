{
  "name": "@founderos/gemini-api",
  "version": "0.0.1",
  "description": "Gemini API adapter — streams tokens via @google/generative-ai SDK (Phase C2 multi-provider)",
  "license": "MIT",
  "homepage": "https://github.com/founderos-ai/founderos",
  "bugs": {
    "url": "https://github.com/founderos-ai/founderos/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/founderos-ai/founderos",
    "directory": "packages/adapters/gemini-api"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@founderos/adapter-utils": "workspace:*",
    "@google/generative-ai": "^0.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.7.3"
  }
}
