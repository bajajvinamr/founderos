{
  "name": "@founderos/adapter-openai-api",
  "version": "0.0.0",
  "description": "OpenAI API adapter (HTTP wrapper, scaffold for S7.B.3/B.4)",
  "license": "MIT",
  "homepage": "https://github.com/founderos-ai/founderos",
  "bugs": {
    "url": "https://github.com/founderos-ai/founderos/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/founderos-ai/founderos",
    "directory": "packages/adapters/openai-api"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "openai-api-runner": "./bin/openai-api-runner.mjs"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@founderos/adapter-utils": "workspace:*",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.7.3"
  }
}
