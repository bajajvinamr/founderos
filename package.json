{
  "name": "founderos",
  "private": true,
  "type": "module",
  "scripts": {
    "preflight:workspace-links": "node cli/node_modules/tsx/dist/cli.mjs scripts/ensure-workspace-package-links.ts",
    "dev": "pnpm --filter @founderos/server exec tsx ../scripts/dev-runner.ts watch",
    "dev:watch": "pnpm --filter @founderos/server exec tsx ../scripts/dev-runner.ts watch",
    "dev:once": "pnpm --filter @founderos/server exec tsx ../scripts/dev-runner.ts dev",
    "dev:list": "pnpm --filter @founderos/server exec tsx ../scripts/dev-service.ts list",
    "dev:stop": "pnpm --filter @founderos/server exec tsx ../scripts/dev-service.ts stop",
    "dev:server": "pnpm --filter @founderos/server dev",
    "dev:ui": "pnpm --filter @founderos/ui dev",
    "build": "pnpm run preflight:workspace-links && pnpm -r build",
    "typecheck": "pnpm run preflight:workspace-links && pnpm -r typecheck",
    "test": "pnpm run preflight:workspace-links && vitest",
    "test:run": "pnpm run preflight:workspace-links && vitest run",
    "test:coverage": "pnpm run preflight:workspace-links && vitest run --coverage",
    "lint": "pnpm -r --if-present run lint",
    "ci:bundle-size": "tsx scripts/ci/bundle-size-check.ts",
    "ci:coverage-summary": "tsx scripts/ci/coverage-summary.ts",
    "db:generate": "pnpm --filter @founderos/db generate",
    "db:migrate": "pnpm --filter @founderos/db migrate",
    "seed:demo": "pnpm --filter @founderos/db exec tsx src/seed-demo.ts && pnpm --filter @founderos/db exec tsx src/seed-demo-depth.ts && pnpm --filter @founderos/db exec tsx src/seed-demo-narrative.ts",
    "seed:demo:reset": "pnpm --filter @founderos/db exec tsx src/seed-demo-reset.ts && pnpm run seed:demo",
    "secrets:migrate-inline-env": "tsx scripts/migrate-inline-env-secrets.ts",
    "db:backup": "./scripts/backup-db.sh",
    "founderos": "node cli/node_modules/tsx/dist/cli.mjs cli/src/index.ts",
    "build:npm": "./scripts/build-npm.sh",
    "release": "./scripts/release.sh",
    "release:canary": "./scripts/release.sh canary",
    "release:stable": "./scripts/release.sh stable",
    "release:github": "./scripts/create-github-release.sh",
    "release:rollback": "./scripts/rollback-latest.sh",
    "fly:provision": "./scripts/fly-provision.sh",
    "fly:smoke": "./scripts/fly-smoke.sh",
    "check:tokens": "node scripts/check-forbidden-tokens.mjs",
    "docs:dev": "cd docs && npx mintlify dev",
    "smoke:openclaw-join": "./scripts/smoke/openclaw-join.sh",
    "smoke:openclaw-docker-ui": "./scripts/smoke/openclaw-docker-ui.sh",
    "smoke:openclaw-sse-standalone": "./scripts/smoke/openclaw-sse-standalone.sh",
    "e2e": "playwright test --config=e2e/playwright.config.ts",
    "e2e:install": "playwright install chromium",
    "test:e2e": "npx playwright test --config tests/e2e/playwright.config.ts",
    "test:smoke": "npx playwright test --config tests/e2e/smoke/playwright.config.ts",
    "test:e2e:headed": "npx playwright test --config tests/e2e/playwright.config.ts --headed",
    "evals:smoke": "cd evals/promptfoo && npx promptfoo@0.103.3 eval",
    "test:release-smoke": "npx playwright test --config tests/release-smoke/playwright.config.ts",
    "test:release-smoke:headed": "npx playwright test --config tests/release-smoke/playwright.config.ts --headed",
    "metrics:founderos-commits": "tsx scripts/founderos-commit-metrics.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "cross-env": "^10.1.0",
    "esbuild": "^0.27.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "patchedDependencies": {
      "embedded-postgres@18.1.0-beta.16": "patches/embedded-postgres@18.1.0-beta.16.patch"
    },
    "overrides": {
      "rollup": ">=4.59.0"
    }
  },
  "version": "0.2.16"
}
